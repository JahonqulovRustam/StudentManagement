
import java.io.*;

public class StudentStorage {
	
	private static final String filename = "C:\\Users\\user\\OneDrive\\Desktop\\StudentList.txt";
	
	public void saveToFile(StudentList list) {
		
		try (BufferedWriter writer = new BufferedWriter(new FileWriter(filename))) {
			
			Object[][] students = list.getAll();
			
			for (Object[] student : students) {
				String line = student[0] + "," + student[1] + "," + student[2] + "," + student[3] + "," + student[4];
				writer.write(line);
				writer.newLine();
			}
			
		} catch (IOException e) {
			System.out.println("Faylga yozishda xatolik: " + e.getMessage());
		}
	}
	
	public void loadFromFile(StudentList list) {
		
		try (BufferedReader reader = new BufferedReader(new FileReader(filename))) {
			
			String line;
			while ((line = reader.readLine()) != null) {
				String[] student = line.split(",");
				list.addStudent(student[1], student[2], Double.parseDouble(student[3]), Integer.parseInt(student[4]));
			}
		
		} catch (IOException e) {
			System.out.println("Fayldan olishda xatolik: " + e.getMessage());
		}
	}
}
