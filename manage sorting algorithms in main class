
import java.util.*;

public class Main {
	public static void  main(String[] args) {
		Scanner sc = new Scanner(System.in);
		StudentList students = new StudentList();
		while (true) {
			System.out.println();
			menu();

			System.out.print("\nAmaliyotni bajarish uchun tanlang: ");
			int num = sc.nextInt();

			switch (num) {

				case 1 :
					System.out.print("Ismni kiriting: ");
					String name = sc.next();
					
					System.out.print("Familiyani kiriting: ");
					String surname = sc.next();
					
					System.out.print("Reytirngini kiriting: ");
					double grade = sc.nextDouble();
					
					System.out.print("Kursini kiriting: ");
					int level = sc.nextInt();
					
					students.addStudent(name, surname, grade, level);
					break;
			
				case 2 :
					
					if (students.size() != 0) {
						
						System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
								"ID", "Ism", "Familiya", "Reyting", "Kurs");
						
						System.out.println("-------------------------------------------------------");
						
						for (int i = 0; i < students.size(); i++) {
							System.out.printf("%-5d %-15s %-15s %-8.2f %-5d%n",
									(int) students.viewAll()[i][0],
									students.viewAll()[i][1],
									students.viewAll()[i][2],
									(double) students.viewAll()[i][3],
									(int) students.viewAll()[i][4]);
						}
					} else {
						
						System.out.println("Hozirda ro'yxatda talaba mavjud emas!");
					}
					
					break;

				case 3 :
					System.out.print("ID ni kiriting: ");
					int id = sc.nextInt();
					
					if (students.hasID(id)) {
					
						System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
								"ID", "Ism", "Familiya", "Reyting", "Kurs");
						
						System.out.println("-------------------------------------------------------");
						
						System.out.printf("%-5d %-15s %-15s %-8.2f %-5d%n",
								(int) students.viewStudentByID(id)[0][0],
								students.viewStudentByID(id)[0][1],
								students.viewStudentByID(id)[0][2],
								(double) students.viewStudentByID(id)[0][3],
								(int) students.viewStudentByID(id)[0][4]);
					} else{
					
						System.out.println("Bunday ID topilmadi!");
					}
					break;

				case 4 :
					System.out.print("ID ni kiriting: ");
					int ad = sc.nextInt();
					sc.nextLine();
					
					if (!students.hasID(ad)) {
						System.out.println("ID topilmadi!");
						break;
					}
					
					System.out.println("Ismi: " + students.getNameById(ad));
					System.out.print("Yangi ismi: ");
					String newName = sc.nextLine();
					
					
					System.out.println("Familiyasi: " + students.getSurnameById(ad));
					System.out.print("Yangi familiyasi: ");
					String newSurname = sc.nextLine();
					
					System.out.println("Reytingi: " + students.getGradeById(ad));
					System.out.print("Yangi bahosi: ");
					String newGrade = sc.nextLine();
					
					
					System.out.println("Kursi: " + students.getLevelById(ad));
					System.out.print("Yangi kursi: ");
					String newLevel = sc.nextLine();
					
					students.updateStudentById(ad,
							!newName.isEmpty() ? newName : students.getNameById(ad),
							!newSurname.isEmpty() ? newSurname : students.getSurnameById(ad),
							!newGrade.isEmpty() ? Double.parseDouble(newGrade) : students.getGradeById(ad),
							!newLevel.isEmpty() ? Integer.parseInt(newLevel) : students.getLevelById(ad));
				
					break;
					
				case 5 :
					System.out.print("ID ni kiriting: ");
					int ayd = sc.nextInt();
					
					boolean result = students.deleteStudentById(ayd);
					
					if (result) {
						System.out.println("Ushbu ID elementi muvaffaiyatli o'chirildi!");
					} else {
						System.out.println("Ushbu ID ga ega student mavjud emas!");
					}
					break;
				
				case 6:
					
					System.out.println("""
            ID bo'yicha sortlash(1)
            Ism bo'yicha sortlash(2)
            Familiya bo'yicha sortlash(3)
            Reytingi bo'yicha sortlash(4)
            Kursi bo'yicha sortlash(5)
            Tugatish(6)
            """);
					
					System.out.print("Birortasini tanlang: ");
					int a = sc.nextInt();
					
					Object[][] sorted = null;
					
					switch (a) {
						case 1:
							sorted = students.sortByID();
							break;
						case 2:
							sorted = students.sortByName();
							break;
						case 3:
							sorted = students.sortBySurname();
							break;
						case 4:
							sorted = students.sortByGrade();
							break;
						case 5:
							sorted = students.sortByLevel();
							break;
						case 6:
							break;
						default:
							System.out.println("Noto'g'ri tanlov!");
							break;
					}
					
					if (sorted != null) {
						System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
								"ID", "Ism", "Familiya", "Reyting", "Kurs");
						
						System.out.println("-------------------------------------------------------");
						
						for (Object[] student : sorted) {
							System.out.printf("%-5d %-15s %-15s %-8.2f %-5d%n",
									(Integer) student[0],
									(String) student[1],
									(String) student[2],
									(Double) student[3],
									(Integer) student[4]);
						}
					}
					
					break;
					
				case 7:
					System.out.println("Dasturdan chiqildi.");
					sc.close();
					return;
				
				default:
					System.out.println("Noto'g'ri tanlov! Qaytadan urinib ko'ring.");
			}
		}
		
	}
	
	public static void menu() {
		System.out.println("1. Student qo'shish");
		System.out.println("2. Studentlar ro'yxati");
		System.out.println("3. ID bo'yicha qidirish");
		System.out.println("4. Tahrirlash");
		System.out.println("5. O'chirish");
		System.out.println("6. Sortlash");
		System.out.println("7. Chiqish");
	}
}
