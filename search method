	public List<Integer> search(String name, String surname, Double grade, Integer level) {
		
		Object[][] objects = getAll();
		List<Integer> indexes = new ArrayList<>();
		
		if (name != null) {
			for (int i = 0; i < objects.length; i++){
				
				if (objects[i][1].toString().toLowerCase().contains(name.toLowerCase())) {
					
					indexes.add((Integer) objects[i][0]);
				}
			}
		}
		
		if (surname != null) {
			for (int i = 0; i < objects.length; i++){
				
				if (objects[i][2].toString().toLowerCase().startsWith(surname.toLowerCase())) {
					
					indexes.add((Integer) objects[i][0]);
				}
			}
		}
		
		if (grade != null) {
			for (int i = 0; i < objects.length; i++){
				
				if ((double)objects[i][3] == grade) {
					
					indexes.add((Integer) objects[i][0]);
				}
			}
		}
		
		if (level != null) {
			for (int i = 0; i < objects.length; i++){
				
				if ((int)objects[i][4] == level) {
					
					indexes.add((Integer) objects[i][0]);
				}
			}
		}
		
		return indexes;
	}
